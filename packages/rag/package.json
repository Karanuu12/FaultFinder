{
  "name": "@timmo/rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./src/types.ts"
    },
    "./embeddings": {
      "types": "./src/embeddings.ts",
      "default": "./src/embeddings.ts"
    },
    "./vectordb": {
      "types": "./src/vectordb.ts",
      "default": "./src/vectordb.ts"
    },
    "./retrieval": {
      "types": "./src/retrieval.ts",
      "default": "./src/retrieval.ts"
    },
    "./llm": {
      "types": "./src/llm.ts",
      "default": "./src/llm.ts"
    },
    "./pipeline": {
      "types": "./src/pipeline.ts",
      "default": "./src/pipeline.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.19.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}