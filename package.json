{
  "name": "timmo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "concurrently -n python,next -c yellow,cyan 'pnpm dev:python' 'pnpm dev:next'",
    "dev:next": "pnpm --filter @timmo/web dev",
    "dev:python": "cd services/document-processor && uv run uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload --log-level info",
    "seed": "pnpm --filter @timmo/web exec tsx ../../scripts/seed.ts",
    "build": "pnpm --filter @timmo/web build",
    "start": "pnpm --filter @timmo/web start",
    "lint": "pnpm --filter @timmo/web lint",
    "typecheck": "pnpm --filter @timmo/web typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.23.13"
  }
}